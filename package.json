{
  "name": "cooking-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Voice-first cooking assistant. Rime is the primary spoken output; Supabase holds per-user recipes, cooking state and memory.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "tsx scripts/preflight.ts",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@eslint/eslintrc": "^3.2.0"
  }
}