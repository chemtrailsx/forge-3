# ---------------------------------------------------------------------------
# Cooking Companion — environment template.
# PLACEHOLDER NAMES ONLY. Copy to .env.local and fill in. Never commit a key.
#
# Everything except the two NEXT_PUBLIC_ values is server-only and is read
# exclusively from server code (route handlers / server components / scripts).
# ---------------------------------------------------------------------------

# --- Supabase: auth + PostgreSQL -------------------------------------------
# Project settings -> API. This key is safe in the browser *because* Row Level
# Security is enabled on every table (see supabase/migrations).
#
# Set ONE of the two key variables below. Newer Supabase projects issue a
# `sb_publishable_...` key; older ones issue a JWT-shaped anon key. Both are the
# browser-safe credential and both work here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never import this into a client component.
# Used solely by scripts/seed-demo.ts.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres connection string, for psql/migration tooling only.
DATABASE_URL=

# --- Rime: primary TTS (REQUIRED) ------------------------------------------
# Free key: https://rime.ai . Server-side only; never reaches the browser.
RIME_API_KEY=
# Validate this triple against Rime's live catalog with `npm run preflight`.
RIME_MODEL_ID=coda
RIME_VOICE_ID=astra
RIME_LANG=en
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLING_RATE=24000
RIME_SEGMENT=immediate
# ws3 is the JSON WebSocket API. It is the only Rime transport exposing
# `operation: clear` (server-side barge-in) and `contextId` (stale-audio
# fencing); both are load-bearing here. RIME_ENDPOINT is the ws3 URL.
RIME_ENDPOINT=wss://users-ws.rime.ai/ws3
# HTTP endpoint. Used for short precise utterances because `timeScaleFactor`
# (dynamic speaking speed) is honoured on HTTP and ignored over WebSocket.
RIME_HTTP_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_CATALOG_URL=https://users.rime.ai/data/voices/all-v2.json

# --- LLM: reasoning, intent, tool selection --------------------------------
# Any OpenAI-compatible provider. Defaults below are Groq's free tier
# (https://console.groq.com — no card required).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Used only while the model above is rate limited. The free tier meters each
# model separately, so a busy minute costs a plainer answer instead of no
# answer. Must support tool calling, and must actually be served by your
# account — check https://api.groq.com/openai/v1/models before changing it.
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- STT: speech to text ---------------------------------------------------
# OpenAI-compatible /audio/transcriptions. Groq's free Whisper by default.
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions

# --- Demo / tuning ---------------------------------------------------------
# Artificial delay injected into tool execution so the voice-filler behaviour
# is demonstrable on a fast network. Set to 0 for production behaviour.
TOOL_DELAY_MS=0
